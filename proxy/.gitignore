# Python
.venv/
__pycache__/
*.pyc

# Node
# Ignore both directories and symlinks: the implement framework symlinks the
# main checkout's node_modules into worktrees, and a trailing-slash pattern
# only matches directories (LP-0MUIH7FYS0010MLT).
node_modules

# Runtime artifacts
logs/
test-results/
session-recordings/

##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores
