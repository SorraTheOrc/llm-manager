[Unit]
Description=LLM podman wrapper — runs llama-server inside podman container
Documentation=https://github.com/SorraTheOrc/llm-manager
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# NOTE: this is the *user-service* template (installed into
# ~/.config/systemd/user/). Do NOT add User=/Group= here — the systemd user
# manager already runs as your user and cannot set supplementary groups, so the
# unit dies at exec with "Failed to determine supplementary groups" /
# status=216/GROUP. For a system service, see docs/systemd/.
WorkingDirectory=/home/rgardler/projects/llm
ExecStart=/home/rgardler/projects/llm/scripts/podman_start_llama.sh router
Environment=LLAMA_HOST_REPO=/home/rgardler/projects/llm
Environment=PODMAN_LC_CONTAINER=llama

# Restart policy (LP-0MVZ810NG008A3EW AC2): always restart the model backend,
# so a model child killed by the OOM killer comes back with the proxy.
Restart=always
RestartSec=2

# OOM ranking (LP-0MVZ810NG008A3EW AC1): raising a score is always permitted, so
# a global OOM prefers this backend over the proxy front door. Keep the proxy's
# value (llama-proxy.service) lower than this one; 0 < 800 on this host. The
# proxy also applies the same value at spawn time (server.llama_server_oom_score_adj).
OOMScoreAdjust=800


# Logging
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=default.target
