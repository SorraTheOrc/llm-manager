#!/bin/sh
# worklog:pre-push-hook:v4
# 1. Enforce branch naming policy: block pushes to protected branches.
# 2. Context-budget regression gate (F6, SA-0MSLK7XNZ00366YY): fail the push
#    when the startup context surface exceeds committed thresholds.
# 3. Scope-aware full-suite gate (LP-0MVFFJWPW007ZEPK, v3-equivalent of
#    SA-0MT6CEN8D0073F61): run the FULL suite when pushing to
#    refs/heads/dev|main; feature-branch pushes skip test execution
#    (implementation validated changed-scope only; the full suite first runs
#    at this dev-push integration gate — SA-0MVECQUGF0064U81). The runner is
#    resolved repo-local first, then the global pi skill install, because this
#    repo ships no repo-local skill/ tree.
# 3a. Pushed-commit guard (LP-0MVSJUM3O003C0H9, v4): the gate only ever
#    measures the tree it is about to push. Before the suite runs, the gated
#    ref's `local_sha` is compared with the gate tree's HEAD and the tree is
#    required to be clean, so a stale or dirty checkout can never produce a
#    green gate that is evidence about a different tree. Refusals are loud,
#    name the pushed commit, the checked-out HEAD, the tree path and the
#    recovery step.
# 4. Auto-sync Worklog data before pushing (committed hooks).
#
# Set WORKLOG_SKIP_PRE_PUSH=1 to bypass worklog sync.
# Set BRANCH_POLICY_SKIP=1 to bypass branch policy check (not recommended).
# Set CONTEXT_BUDGET_SKIP=1 to bypass the context-budget gate (not recommended).
# Set TEST_SCOPE_SKIP=1 to bypass the full-suite gate (and its pushed-commit
# guard; not recommended).
#
# Installed (and verified) by scripts/install_git_hooks.sh; see
# docs/dev/git-hooks.md.
set -e

# ── Branch policy enforcement ────────────────────────────────────────────────
# Check that the current branch is not a protected branch.
if [ "$BRANCH_POLICY_SKIP" != "1" ]; then
  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  # Protected branches that agents must never push to.
  blocked_branches="main master HEAD"
  for blocked in $blocked_branches; do
    if [ "$current_branch" = "$blocked" ]; then
      echo "ERROR: Push to '$current_branch' is blocked by branch policy." >&2
      echo "  Regular agents must NOT push directly to main." >&2
      echo "  Work in feature branches (wl-<id>-<desc>) and push into dev." >&2
      echo "  See the framework ship skill for the push-to-dev workflow." >&2
      exit 1
    fi
  done
fi

# ── Context-budget regression gate ──────────────────────────────────────────
# Fail the push when the pi session startup context surface exceeds the
# committed thresholds (docs/dev/context-budget.thresholds.json). The gate is
# fail-open when the tooling or thresholds file is absent (e.g. worktrees of
# old commits, or repositories that do not ship the context-audit skill).
# measure_context.py is resolved first from the local skill/context-audit/
# path, then from the installed global symlink
# (~/.pi/agent/skills/context-audit/scripts/measure_context.py) installed by
# the framework's install_pi.sh.
if [ "$CONTEXT_BUDGET_SKIP" != "1" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -f "$repo_root/skill/context-audit/scripts/measure_context.py" ]; then
    measure="$repo_root/skill/context-audit/scripts/measure_context.py"
  elif [ -f "$HOME/.pi/agent/skills/context-audit/scripts/measure_context.py" ]; then
    measure="$HOME/.pi/agent/skills/context-audit/scripts/measure_context.py"
  else
    measure=""
  fi
  thresholds="$repo_root/docs/dev/context-budget.thresholds.json"
  if [ -n "$repo_root" ] && [ -n "$measure" ] && [ -f "$measure" ] && [ -f "$thresholds" ]; then
    # Pass --repo-root explicitly: when the global symlink is used, the
    # script's default repo-root resolves to the symlink target (SorraAgents)
    # instead of the project being pushed.
    if python3 "$measure" --repo-root "$repo_root" --include-hidden --thresholds "$thresholds" >/dev/null 2>&1; then
      :
    else
      echo "ERROR: Context budget exceeded committed thresholds." >&2
      echo "  Run: python3 $measure --repo-root $repo_root --include-hidden --thresholds $thresholds" >&2
      echo "  See docs/dev/context-budget.md. Set CONTEXT_BUDGET_SKIP=1 to bypass." >&2
      exit 1
    fi
  fi
fi

# ── stdin capture + scope-aware full-suite gate ─────────────────────────────
# git feeds one line per pushed ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Read every line ONCE (stdin is consumed by the first reader) and capture the
# push targets used by both the test gate and the worklog sync below.
#
# For the gated refs (dev/main) the pushed commit is retained too: the gate is
# only evidence about the commit it actually pushes, so the sha is verified
# against the tree that would be measured (see the pushed-commit guard below).
# Deletion pushes carry the all-zero sha — no commit to verify — and are not
# recorded.
need_full_suite=0
skip_worklog_sync=0
gated_ref_shas=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main)
      need_full_suite=1
      case "$local_sha" in
        ''|*[!0]*) gated_ref_shas="$gated_ref_shas $remote_ref=$local_sha" ;;
      esac
      ;;
    refs/worklog/data) skip_worklog_sync=1 ;;
  esac
done

# Mirror the test-runner cache entries written by a gate run into the main
# checkout's cache. The runner caches per git state under
# <repo>/.worklog/cache (else <git-dir>/test-cache when the repo has no
# .worklog). implement.py pushes from linked worktrees, which have no
# .worklog — a gate run there caches into the worktree's private git dir
# (<main>/.git/worktrees/<name>/test-cache), invisible to the main
# checkout's post-push verification and the audit skill. Copy any entries the
# fresh main checkout does not yet have (keys are content-addressed, so an
# identical key is an identical run). Fail-soft: cache plumbing must never
# decide the push's outcome.
mirror_suite_cache() {
  wt_root="$1"
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
  [ -n "$git_dir" ] && [ -d "$git_dir" ] || return 0
  if [ -d "$wt_root/.worklog" ]; then
    wt_cache="$wt_root/.worklog/cache"
  else
    wt_cache="$git_dir/test-cache"
  fi
  [ -d "$wt_cache" ] && [ -n "$(ls -A "$wt_cache" 2>/dev/null)" ] || return 0
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  case "$common_dir" in
    /*) main_git_dir="$common_dir" ;;
    *) main_git_dir="$(cd "$wt_root" && pwd)/$common_dir" ;;
  esac
  main_root="$(dirname "$main_git_dir")"
  [ "$main_root" != "$wt_root" ] || return 0
  main_cache="$main_root/.worklog/cache"
  [ -d "$main_cache" ] || return 0
  for entry in "$wt_cache"/*; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    [ -e "$main_cache/$name" ] && continue
    if cp -a "$entry" "$main_cache/$name" 2>/dev/null; then
      echo "pre-push: mirrored gate cache entry $name into $main_root/.worklog/cache" >&2
    else
      echo "pre-push: warning: could not mirror cache entry $name into $main_root/.worklog/cache" >&2
    fi
  done
  return 0
}

# Full-suite gate for pushes targeting dev/main (release gates). Partial
# runs are never full-suite evidence, so the gate always runs scope=full.
if [ "$need_full_suite" = "1" ] && [ "$TEST_SCOPE_SKIP" != "1" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  # ── pushed-commit guard (fail closed) ─────────────────────────────────────
  # A green run of the tree in $repo_root is only evidence about the pushed
  # commit when that tree *is* the pushed commit: same HEAD, nothing
  # uncommitted. Otherwise the runner would fingerprint (and cache) a
  # different tree, and the push would report green without the pushed commit
  # ever having been verified (LP-0MVSJUM3O003C0H9, v4).
  if [ -n "$gated_ref_shas" ]; then
    gate_head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
    if [ -z "$repo_root" ] || [ -z "$gate_head" ]; then
      echo "ERROR: pre-push gate cannot resolve the tree it would measure." >&2
      echo "  git rev-parse --show-toplevel in $PWD returned no usable checkout." >&2
      echo "  Push a dev/main ref from a checkout, or set TEST_SCOPE_SKIP=1 (not recommended)." >&2
      exit 1
    fi

    for entry in $gated_ref_shas; do
      pushed_ref="${entry%%=*}"
      pushed_sha="${entry#*=}"
      if [ "$pushed_sha" != "$gate_head" ]; then
        {
          echo "ERROR: pre-push gate refuses this push: the tree it would measure is not the pushed commit."
          echo "  pushed commit  ($pushed_ref): $pushed_sha"
          echo "  checked-out HEAD:            $gate_head"
          echo "  gate tree:                   $repo_root"
          echo "  A full-suite run here would verify a different tree, so the push is refused"
          echo "  before the suite runs."
          echo "  Recovery: bring the main checkout to the pushed commit and re-run"
          echo "            'implement.py finish' (steps 5-6 fast-forward it for exactly this"
          echo "            reason), or verify the commit in a worktree that is checked out at"
          echo "            $pushed_sha and push from there."
          echo "  Escape hatch (explicit, not recommended): TEST_SCOPE_SKIP=1 or git push --no-verify."
        } >&2
        exit 1
      fi
    done

    # Same commit, but a dirty tree can never carry the pushed commit's clean
    # fingerprint: the cached green entry keyed to that dirty state would not
    # be evidence about the pushed commit. .worklog/ is gitignored in this
    # repo, so worklog churn does not trip this check.
    dirty_status="$(git -C "$repo_root" status --porcelain 2>/dev/null || true)"
    if [ -n "$dirty_status" ]; then
      dirty_count="$(printf '%s\n' "$dirty_status" | wc -l | tr -d ' ')"
      {
        echo "ERROR: pre-push gate refuses this push: the gate tree is dirty at the pushed commit."
        echo "  pushed commit: $gate_head"
        echo "  gate tree:     $repo_root"
        echo "  $dirty_count path(s) uncommitted, first 10:"
        printf '%s\n' "$dirty_status" | sed -n '1,10p' | sed 's/^/    /'
        echo "  A full-suite run here fingerprints the dirty state, so a green result"
        echo "  would not be evidence about the pushed commit; the push is refused"
        echo "  before the suite runs."
        echo "  Recovery: stash or commit the changes in the main checkout (never discard"
        echo "            someone else's work), then re-run 'implement.py finish', or verify"
        echo "            the commit in a clean worktree checked out at $gate_head and push from there."
        echo "  Escape hatch (explicit, not recommended): TEST_SCOPE_SKIP=1 or git push --no-verify."
      } >&2
      exit 1
    fi
  fi

  runner=""
  if [ -n "$repo_root" ] && [ -f "$repo_root/skill/test/scripts/run_tests.py" ]; then
    runner="$repo_root/skill/test/scripts/run_tests.py"
  elif [ -f "$HOME/.pi/agent/skills/test/scripts/run_tests.py" ]; then
    runner="$HOME/.pi/agent/skills/test/scripts/run_tests.py"
  fi
  if [ -n "$repo_root" ] && [ -n "$runner" ] && [ -f "$runner" ]; then
    echo "pre-push: full-suite gate for dev/main push — running run_tests.py --scope full --strict-git-env (this can take a while on a cold cache)" >&2
    suite_log="$(mktemp 2>/dev/null || echo "/tmp/pre-push-suite.$$")"
    if python3 "$runner" --scope full --strict-git-env --project-root "$repo_root" --json >"$suite_log" 2>&1; then
      echo "pre-push: full suite green (cached runs make repeat pushes cheap)" >&2
      mirror_suite_cache "$repo_root"
    else
      echo "ERROR: Full test suite failed — pushes to dev/main require a green suite." >&2
      echo "  Run: python3 \"$runner\" --scope full  (or implement.py finish) and fix failures." >&2
      echo "  Set TEST_SCOPE_SKIP=1 to bypass (not recommended)." >&2
      echo "  Runner output (last 40 lines):" >&2
      tail -n 40 "$suite_log" | sed 's/^/    /' >&2 || true
      rm -f "$suite_log"
      exit 1
    fi
    rm -f "$suite_log"
  else
    echo "ERROR: no test runner found — cannot run the full-suite gate for a dev/main push." >&2
    echo "  Install the pi test skill (run_tests.py at ~/.pi/agent/skills/test/scripts/run_tests.py)" >&2
    echo "  or a repo-local skill/test/scripts/run_tests.py. Set TEST_SCOPE_SKIP=1 to bypass (not recommended)." >&2
    exit 1
  fi
fi

# ── Worklog sync ─────────────────────────────────────────────────────────────
if [ "$WORKLOG_SKIP_PRE_PUSH" = "1" ]; then
  echo "worklog: pre-push sync skipped (WORKLOG_SKIP_PRE_PUSH=1)"
  exit 0
fi

# Skip when running inside a temp worktree created by withTempWorktree
# for internal sync operations. These worktrees don't have worklog
# initialized and the push is already done with --no-verify as defense.
case "$PWD" in
  *tmp-worktree-*)
    exit 0
    ;;
esac

# Skip when inside a git worktree (not the main checkout).
# Worktrees are for feature development and typically don't have worklog
# initialized. The sync should run from the main checkout.
if [ "$(git rev-parse --git-dir 2>/dev/null)" != "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
  exit 0
fi

if [ "$skip_worklog_sync" = "1" ]; then
  exit 0
fi

if command -v wl >/dev/null 2>&1; then
  WL=wl
elif command -v worklog >/dev/null 2>&1; then
  WL=worklog
else
  echo "worklog: wl/worklog not found; skipping pre-push sync" >&2
  exit 0
fi

# Force the data branch to refs/worklog/data regardless of config.
# This prevents the sync from accidentally pushing to a standard branch
# if the user has overridden syncBranch in their worklog config.
"$WL" sync --git-branch refs/worklog/data || {
  echo "worklog: pre-push sync failed (pushing anyway)" >&2
  exit 0
}
exit 0
