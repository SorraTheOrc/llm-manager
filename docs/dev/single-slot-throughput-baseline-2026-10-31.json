      "rendered": "216"
    },
    "D9.worst_case_extra_reprefill_tokens": {
      "value": 11500000,
      "unit": "tokens/day (upper bound)",
      "provenance": "derived-estimate",
      "formula": "local_prompt_tokens * steal_pct_pool1_two_sessions / 100, quoted against the re-prefill pool; assumes every stolen prefix is re-prefilled in full and that every local turn follows another session's turn",
      "inputs": ["W2.local_prompt_tokens", "W7.steal_pct_pool1_two_sessions", "W5.reprefill_pool_tokens_per_day"],
