  "derived": {
    "D1.overlap_slot_seconds": {
      "value": 300,
      "unit": "slot-seconds/day",
      "provenance": "derived-estimate",
      "formula": "compute_slot_seconds - busy_seconds (the time a second stream was concurrently resident)",
      "inputs": ["W1.compute_slot_seconds", "W1.busy_seconds"],
      "rendered": "300"
    },
    "D2.overlap_share_of_busy_pct": {
      "value": 3.4,
      "unit": "percent of busy time",
      "provenance": "derived-estimate",
      "formula": "overlap_slot_seconds / busy_seconds * 100",
      "inputs": ["D1.overlap_slot_seconds", "W1.busy_seconds"],
      "rendered": "3.4"
    },
    "D3.turns_at_risk": {
      "value": 15,
      "unit": "local turns/day",
      "provenance": "derived-estimate",
      "formula": "2 * overlap_slot_seconds / avg_stream_duration_seconds (each overlap interval involves two streams)",
      "inputs": ["D1.overlap_slot_seconds", "W1.avg_stream_duration_seconds"],
      "rendered": "15"
    },
    "D4.turns_at_risk_pct": {
      "value": 6.6,
      "unit": "percent of local turns",
      "provenance": "derived-estimate",
      "formula": "turns_at_risk / local_turns * 100",
      "inputs": ["D3.turns_at_risk", "W1.local_turns"],
