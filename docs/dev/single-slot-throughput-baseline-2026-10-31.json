    },
    "D5.single_slot_capacity_use_pct": {
      "value": 10.5,
      "unit": "percent of one slot's daily capacity",
      "provenance": "derived-estimate",
      "formula": "compute_slot_seconds / (1 slot * 86400 s) * 100",
      "inputs": ["W1.compute_slot_seconds"],
      "rendered": "10.5"
    },
    "D6.single_slot_headroom_pct": {
      "value": 89.5,
      "unit": "percent of one slot's daily capacity",
      "provenance": "derived-estimate",
      "formula": "100 - single_slot_capacity_use_pct",
      "inputs": ["D5.single_slot_capacity_use_pct"],
      "rendered": "89.5"
    },
    "D7.prompt_tokens_per_local_turn": {
      "value": 23300,
      "unit": "tokens/turn (rounded)",
      "provenance": "derived-estimate",
      "formula": "local_prompt_tokens / local_turns",
