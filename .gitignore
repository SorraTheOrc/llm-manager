##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores

##################################
# Editor/backup temp files
##################################
# Ignore files created by editors as backups that end with a tilde
# e.g. "file.txt~"
*~

# Python virtualenv
.venv/

# Local slot cache (large runtime artifacts) — must not be committed
slot-cache/

# ds4 is a nested repo (separate project), not a submodule
ds4/

# Session recordings — runtime artifacts (default path now lives OUTSIDE the
# repo at ~/.llm-proxy/session-recordings/, LP-0MT2TC7FG008BXIU). The patterns
# below cover every historical on-disk location so a relative-path fallback can
# never be committed to the source tree again.
proxy/session-recordings/
proxy/proxy/session-recordings/

# Operating-mode state file (fast/cheap) — runtime state, not committed
proxy/.mode
proxy/.mode.override-until
# Session→model binding registry persisted by the proxy (grandfathering across mode switches) — runtime state, not committed
proxy/grandfathering-state.json


bundles/
logs/

# Python bytecode cache
__pycache__/
*.pyc
qwentts.cpp/models/

# Generated benchmark/test artifacts (not source)
benchmark-results/
test-results/

# implement.py runtime state (was accidentally tracked; never commit)
.implement_state.json
